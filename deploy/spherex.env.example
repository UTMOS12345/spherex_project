# Copy to /etc/spherex.env and adjust. Read by the systemd unit on every start.
# Demo mode: cached data only, no downloads (keep this on for the public demo).
SPHEREX_DEMO=1
SPHEREX_CACHE=/srv/spherex-cache

# Cap the FITS cutout cache so a long-running demo cannot fill the disk.
# evict = delete least-recently-used cutouts, stop = fail instead of deleting.
SPHEREX_CACHE_MAX_GB=20
SPHEREX_CACHE_POLICY=evict
SPHEREX_CACHE_TTL_DAYS=45
SPHEREX_CACHE_SWEEP_EVERY=10

# Output folders for prepare_demo.py, make_gallery.py and explore.py.
SPHEREX_DEMO_DIR=/srv/spherex/demo
SPHEREX_OUT_DIR=/srv/spherex/out
