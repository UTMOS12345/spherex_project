[Unit]
Description=SPHEREx Flipbook (Streamlit)
Documentation=https://github.com/UTMOS12345/spherex_project
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spherex
Group=spherex
WorkingDirectory=/srv/spherex
EnvironmentFile=-/etc/spherex.env
Environment=HOME=/srv/spherex
Environment=MPLBACKEND=Agg
Environment=STREAMLIT_SERVER_FILE_WATCHER_TYPE=none
# python -m paramost: the launcher in paramost/cli.py (runs paramost/app.py with the theme)
ExecStart=/srv/spherex/.venv/bin/python -m paramost --no-browser --address 127.0.0.1 --port 8501
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/spherex /srv/spherex-cache /srv/spherex/demo /srv/spherex/out

[Install]
WantedBy=multi-user.target
