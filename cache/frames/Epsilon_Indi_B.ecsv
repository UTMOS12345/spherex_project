# %ECSV 1.0
# ---
# datatype:
# - name: t_min
#   unit: d
#   datatype: float64
#   format: '{:.6f}'
#   description: Lower bound on time axis (Modified Julian Day)
#   meta: !!omap
#   - {ucd: time.start;obs.exposure}
#   - {precision: F6}
#   - {utype: 'obscore:char.timeaxis.coverage.bounds.limits.starttime'}
# - name: t_max
#   unit: d
#   datatype: float64
#   format: '{:.6f}'
#   description: Upper bound on time axis (Modified Julian Day)
#   meta: !!omap
#   - {ucd: time.end;obs.exposure}
#   - {precision: F6}
#   - {utype: 'obscore:char.timeaxis.coverage.bounds.limits.stoptime'}
# - name: energy_bandpassname
#   datatype: string
#   description: Collection-specific name for energy band (e.g. filter name)
#   meta: !!omap
#   - {utype: 'caom2:Energy.bandpassName'}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: em_min
#   unit: m
#   datatype: float64
#   format: '{:.5g}'
#   description: Lower bound on energy axis (barycentric wavelength)
#   meta: !!omap
#   - {ucd: em.wl;stat.min}
#   - {precision: E5}
#   - {utype: 'obscore:char.spectralaxis.coverage.bounds.limits.lolimit'}
# - name: em_max
#   unit: m
#   datatype: float64
#   format: '{:.5g}'
#   description: Upper bound on energy axis (barycentric wavelength)
#   meta: !!omap
#   - {ucd: em.wl;stat.max}
#   - {precision: E5}
#   - {utype: 'obscore:char.spectralaxis.coverage.bounds.limits.hilimit'}
# - name: obs_id
#   datatype: string
#   description: Internal ID given by the ObsTAP service
#   meta: !!omap
#   - {ucd: meta.id}
#   - {utype: 'obscore:dataid.observationid'}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: access_url
#   datatype: string
#   description: URI for the physical artifact
#   meta: !!omap
#   - {ucd: meta.ref.url}
#   - {utype: 'obscore:access.reference'}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - {name: collection, datatype: string}
# - {name: mjd, datatype: float64}
# - {name: detector, datatype: string}
# - {name: date, datatype: string}
# - {name: band_um, datatype: float64}
# schema: astropy-2.0
t_min t_max energy_bandpassname em_min em_max obs_id access_url collection mjd detector date band_um
